# Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git!

# Server
PORT=5000

# Database
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=tododb
DB_PORT=5432
DB_SSL=false

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
